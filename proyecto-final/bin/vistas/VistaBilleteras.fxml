<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="750.0" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.fintech.vistas.BilleterasController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <Label text="Seleccionar Usuario:" />
            <ComboBox fx:id="comboUsuarios" onAction="#handleSeleccionarUsuario" prefWidth="200.0" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleAbrirModalCrearBilletera" style="-fx-background-color: #1565c0; -fx-text-fill: white;" text="+ Nueva Billetera" />
         </children>
      </HBox>
      <TableView fx:id="tablaBilleteras" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colIdBilletera" prefWidth="150.0" text="ID Billetera" />
          <TableColumn fx:id="colTipo" prefWidth="250.0" text="Tipo de Billetera" />
            <TableColumn fx:id="colSaldo" prefWidth="180.0" text="Saldo Disponible ($)" />
            <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" />
        </columns>
      </TableView>
   </children>
</VBox>