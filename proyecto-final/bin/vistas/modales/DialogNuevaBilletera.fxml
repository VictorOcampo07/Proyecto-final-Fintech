<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="400.0" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.fintech.vistas.DialogNuevaBilleteraController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Agregar Billetera Digital" />
      <GridPane hgap="10.0" vgap="10.0">
         <children>
            <Label text="ID Usuario:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtIdUsuario" promptText="Ej: U001" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="ID Billetera:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="txtIdBilletera" promptText="Ej: B003" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Tipo de Billetera:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <ComboBox fx:id="comboTipoBilletera" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="Saldo Inicial ($):" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <TextField fx:id="txtSaldoInicial" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="3" />
         </children>
      </GridPane>
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleCancelar" text="Cancelar" />
            <Button mnemonicParsing="false" onAction="#handleGuardar" style="-fx-background-color: #388E3C; -fx-text-fill: white;" text="Crear Billetera" />
         </children>
      </HBox>
   </children>
</VBox>