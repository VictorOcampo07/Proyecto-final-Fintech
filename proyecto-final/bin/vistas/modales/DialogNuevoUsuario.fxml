<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="400.0" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.fintech.vistas.DialogNuevoUsuarioController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Registrar Nuevo Usuario" />
      <GridPane hgap="10.0" vgap="10.0">
         <children>
            <Label text="ID Usuario:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtId" promptText="Ej: U003" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="Nombre Completo:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="txtNombre" promptText="Ej: Juan Perez" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Correo Electrónico:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="txtEmail" promptText="juan@mail.com" GridPane.columnIndex="1" GridPane.rowIndex="2" />
         </children>
      </GridPane>
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleCancelar" text="Cancelar" />
            <Button mnemonicParsing="false" onAction="#handleGuardar" style="-fx-background-color: #1976D2; -fx-text-fill: white;" text="Guardar Usuario" />
         </children>
      </HBox>
   </children>
</VBox>