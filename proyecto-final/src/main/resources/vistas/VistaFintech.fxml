<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="fintech.vistas.MainWindowController" prefHeight="600.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
   <center>
      <TabPane BorderPane.alignment="CENTER" tabClosingPolicy="UNAVAILABLE">
        <tabs>
          
          <!-- Pestaña 1: Gestión de Usuarios y Billeteras -->
          <Tab text="Usuarios y Billeteras">
               <content>
                  <VBox spacing="10.0">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                     </padding>
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Listado de Usuarios Registrados y Puntos Acumulados"/>
                        <TableView VBox.vgrow="ALWAYS" fx:id="tablaUsuarios">
                          <columns>
                            <TableColumn fx:id="colId" prefWidth="120.0" text="ID Usuario"/>
                            <TableColumn fx:id="colNombre" prefWidth="250.0" text="Nombre Completo"/>
                              <TableColumn fx:id="colPuntos" prefWidth="150.0" text="Puntos Fidelidad"/>
                              <TableColumn fx:id="colNivel" prefWidth="150.0" text="Nivel (Fidelización)"/>
                          </columns>
                        </TableView>
                     </children>
                  </VBox>
               </content>
          </Tab>
          
          <!-- Pestaña 2: Operaciones Financieras y Reversión -->
          <Tab text="Operaciones Financieras">
               <content>
                  <VBox spacing="15.0">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                     </padding>
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Procesar Nueva Operación"/>
                        <GridPane hgap="10.0" vgap="10.0">
                           <children>
                              <Label GridPane.columnIndex="0" GridPane.rowIndex="0" text="Tipo de Operación:"/>
                              <ComboBox GridPane.columnIndex="1" GridPane.rowIndex="0" fx:id="comboTipoOp" prefWidth="200.0"/>
                              
                              <Label GridPane.columnIndex="0" GridPane.rowIndex="1" text="Billetera Origen ID:"/>
                              <TextField GridPane.columnIndex="1" GridPane.rowIndex="1" fx:id="txtOrigen" promptText="Ej: B001"/>
                              
                              <Label GridPane.columnIndex="0" GridPane.rowIndex="2" text="Billetera Destino ID:"/>
                              <TextField GridPane.columnIndex="1" GridPane.rowIndex="2" fx:id="txtDestino" promptText="Ej: B002"/>
                              
                              <Label GridPane.columnIndex="0" GridPane.rowIndex="3" text="Monto ($):"/>
                              <TextField GridPane.columnIndex="1" GridPane.rowIndex="3" fx:id="txtMonto" promptText="0.00"/>
                           </children>
                        </GridPane>
                        <HBox spacing="15.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#handleEjecutarOperacion" style="-fx-background-color: #2e7d32; -fx-text-fill: white;" text="Procesar Transacción"/>
                              <Button mnemonicParsing="false" onAction="#handleRevertirOperacion" style="-fx-background-color: #c62828; -fx-text-fill: white;" text="Revertir Última Operación (Pila LIFO)"/>
                           </children>
                           <VBox.margin>
                              <Insets top="10.0"/>
                           </VBox.margin>
                        </HBox>
                     </children>
                  </VBox>
               </content>
          </Tab>
          
          <!-- Pestaña 3: Analítica de Transacciones, BST y Grafos -->
          <Tab text="Analítica &amp; Grafos">
               <content>
                  <VBox spacing="10.0">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                     </padding>
                     <children>
                        <Button mnemonicParsing="false" onAction="#handleGenerarReporte" text="Generar Reporte Completo de Analítica"/>
                        <TextArea VBox.vgrow="ALWAYS" editable="false" fx:id="areaAnalitica" prefHeight="200.0" prefWidth="200.0" style="-fx-font-family: monospace;"/>
                     </children>
                  </VBox>
               </content>
          </Tab>
          
        </tabs>
      </TabPane>
   </center>
</BorderPane>