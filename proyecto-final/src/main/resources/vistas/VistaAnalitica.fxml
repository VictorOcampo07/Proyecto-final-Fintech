<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="750.0" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.fintech.vistas.AnaliticaController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Módulo de Analítica Avanzada &amp; Auditoría" />
      <Button mnemonicParsing="false" onAction="#handleGenerarReporte" style="-fx-background-color: #00838f; -fx-text-fill: white;" text="Generar Informe Completo (Grafos, Auditoría y BST)" />
      <TextArea fx:id="areaAnalitica" editable="false" prefHeight="200.0" prefWidth="200.0" style="-fx-font-family: monospace;" VBox.vgrow="ALWAYS" />
   </children>
</VBox>