<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="750.0" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.fintech.vistas.ProgramadasController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Programar Transacción Futura (PriorityQueue / Min-Heap)" />
      <GridPane hgap="10.0" vgap="10.0">
         <children>
            <Label text="Billetera Origen:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtOrigen" promptText="B001" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="Billetera Destino:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <TextField fx:id="txtDestino" promptText="B002" GridPane.columnIndex="3" GridPane.rowIndex="0" />
            <Label text="Monto ($):" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="txtMonto" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Fecha Ejecución:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <DatePicker fx:id="dpFecha" GridPane.columnIndex="3" GridPane.rowIndex="1" />
         </children>
      </GridPane>
      <HBox spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleProgramar" style="-fx-background-color: #6a1b9a; -fx-text-fill: white;" text="Programar Operación" />
            <Button mnemonicParsing="false" onAction="#handleSimularEjecucion" style="-fx-background-color: #ef6c00; -fx-text-fill: white;" text="Simular Procesamiento Automático" />
         </children>
      </HBox>
      <Label style="-fx-font-weight: bold;" text="Operaciones Programadas Pendientes (Ordenadas por Prioridad de Fecha):" />
      <TableView fx:id="tablaProgramadas" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colFecha" prefWidth="180.0" text="Fecha Ejecución" />
            <TableColumn fx:id="colOrigen" prefWidth="150.0" text="Origen" />
            <TableColumn fx:id="colDestino" prefWidth="150.0" text="Destino" />
            <TableColumn fx:id="colMonto" prefWidth="150.0" text="Monto ($)" />
         </columns>
      </TableView>
   </children>
</VBox>